{
  "name": "origami-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/lab/index.ts --outDir dist/api",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "preclydie": "vite build --ssr src/clydie/episode.ts --outDir .clydie-build",
    "clydie": "node scripts/run-clydie.mjs"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
